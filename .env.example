# Copy this file to .env and fill in your real Firebase project config
# once you have one. Until then, leave EXPO_PUBLIC_USE_FIREBASE_EMULATOR=true
# and run `npm run emulators` — the app will talk to your local Firebase
# Emulator Suite instead, so none of the values below need to be real.

EXPO_PUBLIC_USE_FIREBASE_EMULATOR=true

EXPO_PUBLIC_FIREBASE_API_KEY=demo-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-victory-manutencao.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=demo-victory-manutencao
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-victory-manutencao.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
EXPO_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Host to reach the emulators from. Use 127.0.0.1 for iOS simulator / web,
# and your machine's LAN IP (e.g. 192.168.1.20) for a physical device or
# the Android emulator (10.0.2.2 also works for the Android emulator).
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1
